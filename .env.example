# INTISAT — copiar este archivo a `.env` (mismo directorio) y poner una
# contraseña propia. `.env` NO se sube al repo (ver .gitignore).
#
# La usan docker-compose.web.yml (crea el usuario en ClickHouse) y el
# backend web (webapp/backend/config.py, para conectarse) — deben coincidir.

INTISAT_CH_PASSWORD=cambiar-esta-contrasena

# Login de administrador para Configuración/Programación (webapp/backend/auth.py).
INTISAT_ADMIN_USER=admin
INTISAT_ADMIN_PASSWORD=cambiar-esta-contrasena-tambien
